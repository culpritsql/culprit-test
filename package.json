{
  "name": "@culpritsql/test",
  "version": "0.5.7",
  "description": "Execution plan regression assertions, Vitest/Jest matchers, and safe EXPLAIN runners powered by @culpritsql/plans.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "build": "tsc --emitDeclarationOnly && esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --sourcemap --external:@culpritsql/plans --external:node:fs/promises --outfile=dist/index.js",
    "test": "bun test"
  },
  "dependencies": {
    "@culpritsql/plans": "^0.5.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.4",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/culpritsql/culprit-test.git"
  },
  "homepage": "https://explain.culpritsql.com",
  "bugs": {
    "url": "https://github.com/culpritsql/culprit-test/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "sql",
    "execution-plan",
    "query-plan",
    "explain",
    "regression-testing",
    "vitest",
    "jest",
    "reylo",
    "drizzle",
    "kysely",
    "postgres",
    "postgresql",
    "mssql",
    "sql-server",
    "mysql",
    "mariadb",
    "yugabytedb",
    "sqlite"
  ]
}
